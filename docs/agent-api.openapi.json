  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token",
        "description": "Firebase Auth ID token from the account whose data you manage. Refresh with Firebase Auth REST API. Server checks revocation."
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "purgeAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "isPinned": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "color"
        ]
      },
      "ProjectCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional stable client-selected ID for safe retries. Omit for a random ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "isPinned": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "color"
        ]
      },
      "ProjectPatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "isPinned": {
            "type": "boolean"
          }
        }
      },
      "ProjectResult": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Project"
          }
        }
      },
      "ProjectList": {
        "type": "object",
        "required": [
          "data",
          "nextCursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Opaque URL-safe cursor. Continue even if data is empty; stop only at null."
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "purgeAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "projectId",
          "startTime"
        ]
      },
      "EventCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional stable client-selected ID for safe retries. Omit for a random ID."
          },
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "projectId",
          "startTime"
        ],
        "description": "isActive defaults to false. Completed entries require endTime > startTime. Active entries require null/omitted endTime. projectId must refer to your available project."
      },
      "EventPatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "minLength": 1,
            "maxLength": 128
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "description": "Merged event must have endTime > startTime if completed, null/omitted endTime if active. Stop a timer by setting isActive=false and endTime together. Clear description with an empty string."
      },
      "EventResult": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Event"
          }
        }
      },
      "EventList": {
        "type": "object",
        "required": [
          "data",
          "nextCursor"
        ],
        "properties": {
