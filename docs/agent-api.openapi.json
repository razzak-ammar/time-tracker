{
  "openapi": "3.0.3",
  "info": {
    "title": "TimeTracker Agent API",
    "version": "1.1.0",
    "description": "Authenticated project and time-entry management. Events map to Firestore timeEntries. See AGENT_API.md for authentication, pagination, retries, deployment and examples. Event filters run as indexed Firestore queries; isActive combined with other filters is applied per page, so continue through empty pages until nextCursor is null. PATCH and event DELETE accept an optional If-Match precondition (the record's updatedAt). At most one non-deleted active timer exists per user. No project delete, restore, or permanent delete HTTP operations."
  },
  "servers": [
    {
      "url": "https://us-central1-time-tracker-3b6df.cloudfunctions.net/agentApi",
      "description": "Available after deploying functions:agentApi; override for other projects."
    }
  ],
  "security": [
    {
      "firebaseIdToken": []
    }
  ],
  "paths": {
