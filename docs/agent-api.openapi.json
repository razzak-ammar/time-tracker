          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            },
            "description": "Maximum documents read per page; in-memory filters (trash, and isActive combined with other filters) may return fewer."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "minLength": 1,
              "maxLength": 1024
            },
            "description": "Opaque nextCursor from the previous page of the same list; keep all filters unchanged."
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include recoverable trash."
          },
          {
            "name": "projectId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Filter by project ID."
          },
          {
            "name": "isActive",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by timer state. Alone it is an indexed query; combined with projectId/from/to it is applied per page."
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
            },
            "description": "Inclusive startTime bound."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with seconds, timezone, and optional 1\u20133 fractional digits. Responses use UTC."
            },
            "description": "Exclusive startTime bound; must be after from."
          }
        ]
      },
