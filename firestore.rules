rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if the user owns the document being written
    function isOwnerOfIncoming() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Helper function to validate timestamp fields
    function isValidTimestamp(field) {
      return field is timestamp;
    }

    // Deletion metadata is owned by callable Functions and Firestore TTL. A
    // browser can never turn a soft delete into a hard delete or forge a
    // restore/cascade relationship.
    function hasNoTrashFields(data) {
      return !data.keys().hasAny(['deletedAt', 'purgeAt', 'deletionId']);
    }

    function doesNotChangeTrashFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['deletedAt', 'purgeAt', 'deletionId']);
    }

    function isNotTrashed(data) {
      return !data.keys().hasAny(['deletedAt']) || data.deletedAt == null;
    }

    function isAvailableProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        && (!get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletedAt'])
          || get(/databases/$(database)/documents/projects/$(projectId)).data.deletedAt == null);
    }
    
    // ============================================
    // PROJECTS COLLECTION
    // ============================================
    match /projects/{projectId} {
      // Users can read their own projects
      allow read: if isOwner(resource.data.userId);
      
      // Users can create projects if they set themselves as the owner
      allow create: if isOwnerOfIncoming()
        && request.resource.data.keys().hasAll(['name', 'color', 'userId', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt)
        && hasNoTrashFields(request.resource.data);
      
      // Users can update their own projects (cannot change userId)
      allow update: if isOwner(resource.data.userId)
        && isNotTrashed(resource.data)
        && isOwnerOfIncoming()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && isValidTimestamp(request.resource.data.updatedAt)
        && doesNotChangeTrashFields();
      
      // Physical removal is restricted to trusted callable Functions / TTL.
      allow delete: if false;
    }
    
    // ============================================
    // TIME ENTRIES COLLECTION
    // ============================================
    match /timeEntries/{entryId} {
      // Users can read their own time entries
      allow read: if isOwner(resource.data.userId);
      
      // Users can create time entries if they set themselves as the owner
      allow create: if isOwnerOfIncoming()
        && request.resource.data.keys().hasAll(['userId', 'projectId', 'startTime', 'isActive', 'createdAt', 'updatedAt'])
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && isAvailableProject(request.resource.data.projectId)
        && isValidTimestamp(request.resource.data.startTime)
        && request.resource.data.isActive is bool
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt)
        // A running timer has no end; every completed event has a valid,
        // positive time range. This prevents the timer state and its reported
        // duration from diverging, including writes from another open tab.
        && ((request.resource.data.isActive == true
          && (!('endTime' in request.resource.data) || request.resource.data.endTime == null))
          || (request.resource.data.isActive == false
            && isValidTimestamp(request.resource.data.endTime)
            && request.resource.data.endTime > request.resource.data.startTime))
        // description is optional
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        // endTime is null or absent only when the timer is active.
        && (!('endTime' in request.resource.data) || request.resource.data.endTime == null || isValidTimestamp(request.resource.data.endTime))
        && hasNoTrashFields(request.resource.data);
      
      // Users can update their own time entries (cannot change userId)
      allow update: if isOwner(resource.data.userId)
        && isNotTrashed(resource.data)
        && isOwnerOfIncoming()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && isAvailableProject(request.resource.data.projectId)
        && isValidTimestamp(request.resource.data.startTime)
        && request.resource.data.isActive is bool
        && isValidTimestamp(request.resource.data.updatedAt)
        && ((request.resource.data.isActive == true
          && (!('endTime' in request.resource.data) || request.resource.data.endTime == null))
          || (request.resource.data.isActive == false
            && isValidTimestamp(request.resource.data.endTime)
            && request.resource.data.endTime > request.resource.data.startTime))
        // description is optional
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        // endTime is null or absent only when the timer is active.
        && (!('endTime' in request.resource.data) || request.resource.data.endTime == null || isValidTimestamp(request.resource.data.endTime))
        && doesNotChangeTrashFields();
      
      // Physical removal is restricted to trusted callable Functions / TTL.
      allow delete: if false;
    }

    // Aggregate documents are created by the Admin SDK only. Users can read
    // their own summaries but cannot alter reporting totals from a client.
    match /users/{userId}/summaries/{summaryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/dailySummaries/{dateKey} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/projectSummaries/{projectId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    
    // ============================================
    // DEFAULT: Deny all other access
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
